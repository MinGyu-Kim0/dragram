# 프로젝트 루트의 .env 파일로 복사해 사용하세요.
OPENAI_API_KEY=
# 분석에 쓸 OpenAI 모델 이름
OPENAI_MODEL=gpt-6-luna
# 모든 LLM 호출에 적용. 미설정·빈 값은 low이며, 변경 후 backend·worker를 다시 만든다.
OPENAI_REASONING_EFFORT=low
# Google 로그인 OAuth 클라이언트 ID(공개 값). 백엔드 검증과 웹 버튼에 같은 값을 넣으세요.
# 클라이언트 비밀값은 쓰지 않습니다. 승인된 JavaScript 출처에 http://localhost:5173을 넣으세요.
# 운영 서버에서는 VITE_GOOGLE_CLIENT_ID를 쓰지 않고 GOOGLE_CLIENT_ID로 웹을 빌드합니다.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# 아래 VITE_ 값은 웹에 들어가는 공개 값입니다. 운영 서버의 값은 배포할 때 웹 빌드에 쓰입니다.
# 웹이 연결 메시지를 보낼 확장 프로그램 ID. 개발용 ID는 manifest key로 고정되어 있습니다.
# 운영 서버에는 웹 스토어가 정한 ID를 넣으세요.
VITE_EXTENSION_ID=ilhnmbeleinmgfcigakmfobgngiillah
# 소개 홈의 'Chrome에 추가' 주소. 비우면 '준비 중'으로 보입니다.
VITE_CHROME_WEB_STORE_URL=
# 개인정보처리방침·이용약관의 연락 메일과 개인정보 보호책임자. 비우면 '준비 중'으로 보입니다.
VITE_CONTACT_EMAIL=
VITE_PRIVACY_OFFICER=
# 로컬 수동 확인용 개발 로그인(POST /api/auth/dev-login/). DEBUG일 때만 열립니다.
DEV_LOGIN_ENABLED=false
# 사용자별 하루(Asia/Seoul) LLM 토큰 한도(입력+출력)와 동시 분석 요청 상한
ANALYSIS_DAILY_TOKEN_LIMIT=200000
ANALYSIS_MAX_CONCURRENT=10
# chrome://extensions 에 표시되는 Dragram 확장 프로그램 ID로 바꾸세요.
EXTENSION_ORIGIN=chrome-extension://your-extension-id
# 평가 실행(python manage.py evaluate) 비용 계산 단가, 백만 토큰당 달러. 하나라도 비우면 비용을 계산하지 않습니다.
EVAL_PRICE_INPUT=
EVAL_PRICE_CACHED_INPUT=
EVAL_PRICE_OUTPUT=
