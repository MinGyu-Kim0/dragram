# 이 저장소가 쓰는 도구의 규칙만 둔다. web/·extension/·e2e/의 규칙은 각 폴더 .gitignore에 있다.

# Python(backend: uv, pytest, ruff)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node(e2e/ 의존성. web/·extension/도 각자 막는다)
node_modules/

# 로컬 비밀값·DB 덤프
.env
*.dump

# Claude Code(로컬 설정, 워크트리, 작업 메모)
.claude
plan.md
