{
  "name": "dragram-extension",
  "description": "읽고 있는 일본어 문장을 드래그하면 번역과 그 문장에 쓰인 문법·단어를 사이드 패널에 보여줘요.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:store": "DRAGRAM_STORE=true WXT_API_BASE_URL=https://dragram.app WXT_WEB_ORIGIN=https://dragram.app wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
