# 운영 서버의 ~/dragram/.env 견본. 실제 값은 서버에만 두고 저장소에 올리지 않는다.
SITE_ADDRESS=dragram.app

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

OPENAI_API_KEY=
# 비우면 OpenAI 호출이 실패한다.
OPENAI_MODEL=gpt-6-luna
# 모든 LLM 호출에 적용. 미설정·빈 값은 low이며, 변경 후 backend·worker를 다시 만든다.
OPENAI_REASONING_EFFORT=low
GOOGLE_CLIENT_ID=
# load_jmdict로 사전을 적재할 때만 쓰는 판본 이름(#198). 비어 있으면 적재를 거부한다.
JMDICT_EDITION=

# 사용자별 하루(Asia/Seoul) LLM 토큰 한도와 동시 분석 요청 상한. 비우면 아래 값이다.
ANALYSIS_DAILY_TOKEN_LIMIT=200000
ANALYSIS_MAX_CONCURRENT=10

# 아래 VITE_ 값은 웹 빌드에 들어가는 공개 값이다. 바꾸면 infra/deploy.sh로 다시 배포한다.
# 운영 웹이 연결 메시지를 보낼 확장 ID. 스토어 승인 전에는 개발용 ID, 승인 뒤에는 스토어가 정한 ID.
VITE_EXTENSION_ID=ilhnmbeleinmgfcigakmfobgngiillah
# 소개 홈의 'Chrome에 추가' 주소. 비우면 '준비 중'으로 보인다.
VITE_CHROME_WEB_STORE_URL=
# 처리방침·약관의 연락 메일과 개인정보 보호책임자. 비우면 '준비 중'·'확인 필요'로 보인다.
VITE_CONTACT_EMAIL=
VITE_PRIVACY_OFFICER=
