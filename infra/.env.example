# 운영 서버의 ~/dragram/.env 견본. 실제 값은 서버에만 두고 저장소에 올리지 않는다.
SITE_ADDRESS=dragram.app

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=
# 모든 LLM 호출에 적용. 미설정·빈 값은 low이며, 변경 후 backend·worker를 다시 만든다.
OPENAI_REASONING_EFFORT=low
GOOGLE_CLIENT_ID=
JMDICT_EDITION=
